<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android Automotive OS (FusedLocation AAR also declares this). -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Keeps the value guard alive while navigation is full screen (see monitor/MonitorService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pleos Vehicle SDK 2.3.2: read (Vehicle State SDK, no application needed) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- getTelltalesInfo is refused without it on emulator 2.1.0; needs App Market review on vehicles. -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <!-- Pleos Vehicle SDK 2.3.2: control. App Market approval required; every call degrades to a spoken suggestion. -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_DOORS" />
    <!-- NaviHelper 3.0.5 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- requestNavigationScreen (place search "블루핸즈", nearby chargers): refused without it on emulator 2.1.0 -->
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <!-- TextToSpeech / SpeechToText 3.3.1 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- FusedLocation 1.1.3 (dangerous: runtime request) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- AAOS Car API: speed / wheel ticks (CAR_SPEED, dangerous), gear / parking brake, outside temperature,
         battery health and charging (CAR_ENERGY, dangerous), make / model / year (CAR_INFO) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY_PORTS" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarValue"
        tools:targetApi="34">

        <!-- No screenOrientation: Pleos requires portrait (1 window) and landscape (2 windows) with feature parity.
             configChanges keeps the WebView (and the running fatigue engine) alive across window resizes. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Distraction Optimized: usable while driving (UI still honours CarUxRestrictions). -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <service
            android:name=".monitor.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Drowsy-driving monitoring of vehicle signals while another app (navigation) is in the foreground" />
        </service>

        <!-- Gleo Interface: component="service" in assets/schema.json → Gleo sends a broadcast whose action is the
             function name. Exported because Gleo is another package; the receiver only accepts these 5 actions. -->
        <receiver
            android:name=".gleo.GleoReceiver"
            android:exported="true">
            <intent-filter><action android:name="GET_CAR_VALUE" /></intent-filter>
            <intent-filter><action android:name="GET_BATTERY_HEALTH" /></intent-filter>
            <intent-filter><action android:name="SET_CHARGE_LIMIT" /></intent-filter>
            <intent-filter><action android:name="FIND_SERVICE_CENTER" /></intent-filter>
            <intent-filter><action android:name="GET_TRADE_IN_QUOTE" /></intent-filter>
        </receiver>
    </application>
</manifest>
