<?xml version="1.0" encoding="utf-8"?>
<!-- 깨움 glyph: an eye whose pupil is a sun rising over the lower lid. Kept inside the 66dp adaptive safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- eye outline -->
    <path
        android:pathData="M30,58 Q54,34 78,58 Q54,74 30,58 Z"
        android:strokeColor="#3CF2C8"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- horizon -->
    <path
        android:pathData="M38,58 L70,58"
        android:strokeColor="#3CF2C8"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
    <!-- rising sun (pupil) -->
    <path
        android:pathData="M45,58 A9,9 0 0,1 63,58 Z"
        android:fillColor="#3CF2C8" />
    <!-- rays -->
    <path
        android:pathData="M54,41 L54,35 M42,44 L38,39 M66,44 L70,39"
        android:strokeColor="#3CF2C8"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
</vector>
