<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pleos background_primary (basic_50): light #F7F8FA; the night palette lives in values-night. -->
    <color name="app_bg">#F7F8FA</color>
    <color name="app_accent">#00A389</color>

    <style name="Theme.CarValue" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
    </style>
</resources>
