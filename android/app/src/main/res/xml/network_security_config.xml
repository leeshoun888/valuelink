<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only (Pleos security guide). The UI itself is served from https://appassets.androidplatform.net. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
